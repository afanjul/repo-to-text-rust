{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RepoToText",
  "version": "0.1.0",
  "identifier": "com.repototext.app",
  "build": {
    "frontendDist": "frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "RepoToText",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "acl": {
      "allowed": [],
      "scopes": {
        "default": {
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "clipboard:allow-write-text"
          ]
        }
      }
    }
  }
}
